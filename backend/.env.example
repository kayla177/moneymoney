# Copy to .env and fill in. NEVER commit the real .env.

# Dedicated Gmail inbox that receives the bank alert emails.
GMAIL_ADDRESS=your-dedicated-inbox@gmail.com
# App password generated in Google Account > Security (requires 2FA). NOT your login password.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_IMAP_HOST=imap.gmail.com

# Where the SQLite file lives. Defaults to ./moneymoney.db if unset.
DATABASE_URL=sqlite:///moneymoney.db

# How often the poller checks for new email, in seconds.
POLL_INTERVAL_SECONDS=60

# Auth for the API. Leave APP_PASSWORD unset for local dev (auth disabled). Set it before
# any public deployment so your transaction data isn't exposed.
APP_USERNAME=me
APP_PASSWORD=
